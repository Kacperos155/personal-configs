# Common settings for global/system git config
[core]
    editor = nvim -n
[diff]
    wsErrorHighlight = all
    # Tools:
    tool = nvimdiff
    guitool = vscode
[feature]
    manyFiles = true
[fetch]
    prune = true
[grep]
    extendedRegexp = true
    lineNumber = true
[log]
    date = iso
[merge]
    conflictStyle = zdiff3
    # Tools:
    tool = nvimdiff
    guitool = vscode
[pull]
    ff = only
